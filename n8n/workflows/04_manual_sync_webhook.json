{
  "name": "[ANALYTICS] 04_Manual_Sync_Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analytics-sync",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "webhookId": "analytics-sync-webhook-id"
    },
    {
      "parameters": {
        "url": "=http://host.docker.internal:8000/api/v1/internal/posts/active?workspace_id={{ .body.workspace_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "default-internal-secret-key-12345"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Workspace Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"acknowledged\",\n  \"workspace_id\": \"{{ Webhook Trigger.first().json.body.workspace_id }}\",\n  \"synced_posts\": {{ .total_posts || 0 }}\n}",
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Fetch Workspace Posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Workspace Posts": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}